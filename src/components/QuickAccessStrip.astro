---
// Quick-access strip — brand signature under the primary nav.
// Five tiles, navy panel, flat-line iconography (Lucide-style).
const tiles = [
  { label: 'Dam Levels',        href: '#' },
  { label: 'Water Quality',     href: '#' },
  { label: 'Contractor Portal', href: '#' },
  { label: 'Payment Options',   href: '#' },
  { label: 'Education',         href: '#' },
];
---
<div class="quick-strip" role="navigation" aria-label="Quick access">
  <a class="qs-tile" href={tiles[0].href}>
    <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 20V6l8-4 8 4v14"/><path d="M4 12h16"/></svg>
    <span>{tiles[0].label}</span>
  </a>
  <a class="qs-tile" href={tiles[1].href}>
    <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2v6M12 14v8M5 8h14M7 18h10"/></svg>
    <span>{tiles[1].label}</span>
  </a>
  <a class="qs-tile" href={tiles[2].href}>
    <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 21h18M6 21V9l6-4 6 4v12"/></svg>
    <span>{tiles[2].label}</span>
  </a>
  <a class="qs-tile" href={tiles[3].href}>
    <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="6" width="18" height="12" rx="2"/><path d="M3 10h18"/></svg>
    <span>{tiles[3].label}</span>
  </a>
  <a class="qs-tile" href={tiles[4].href}>
    <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 8l10-5 10 5-10 5L2 8z"/><path d="M6 10v6l6 3 6-3v-6"/></svg>
    <span>{tiles[4].label}</span>
  </a>
</div>

<style>
  .quick-strip {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 1px;
    background: #0A4C73;
    border-bottom: 1px solid #001F37;
  }
  .qs-tile {
    background: #003A5D;
    color: #fff;
    text-decoration: none;
    padding: 14px 16px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    transition: background 120ms cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  .qs-tile:hover { background: #0A4C73; }
  .qs-tile span {
    font-size: 10px;
    letter-spacing: 0.12em;
    font-weight: 700;
    text-transform: uppercase;
  }
</style>
